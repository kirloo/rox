fun fibs(n) {
  var a = 0;
  var temp;
  for (var b = 1; a < n; b = temp + b) {
    print a;
    temp = a;
    a = b;
  }
}

var start = clock();
fibs(10000);
var end = clock();

fun diff(s, e) {
  return e - s;
}

var elapsed = diff(start, end);

print "start";
print start;
print "end";
print end;
print "elapsed";
print elapsed;